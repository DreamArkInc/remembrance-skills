{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/node-launcher\" \"${CURSOR_PLUGIN_ROOT}/scripts/session-start.mjs\"",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/node-launcher\" \"${CURSOR_PLUGIN_ROOT}/scripts/record-task-eligibility.mjs\"",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/node-launcher\" \"${CURSOR_PLUGIN_ROOT}/scripts/record-mcp-use.mjs\"",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/node-launcher\" \"${CURSOR_PLUGIN_ROOT}/scripts/post-tool-use.mjs\"",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/node-launcher\" \"${CURSOR_PLUGIN_ROOT}/scripts/pre-compact.mjs\"",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/node-launcher\" \"${CURSOR_PLUGIN_ROOT}/scripts/contribute-on-stop.mjs\"",
        "timeout": 5,
        "loop_limit": 1
      }
    ]
  }
}
