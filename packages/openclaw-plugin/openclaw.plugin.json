{
  "id": "remembrance",
  "name": "Remembrance",
  "version": "0.2.4",
  "description": "Discover or directly invoke authorized Remembrance skills in OpenClaw, then close the outcome and feedback loop.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "privateLessonSubmitApproval": {
        "type": "boolean",
        "default": false,
        "description": "Persist allow-always only for submit_private_lesson_candidate."
      },
      "privateLearningEgressApprovals": {
        "type": "object",
        "additionalProperties": false,
        "description": "Saved allow-always decisions, one per Remembrance egress lane. The plugin sets a lane to true when the user chooses allow-always; that decision covers only the actions of that lane, such as the private_lesson submit and retry actions.",
        "properties": {
          "private_lesson": {
            "type": "boolean"
          },
          "private_skill": {
            "type": "boolean"
          },
          "conditional_feedback": {
            "type": "boolean"
          },
          "remembrance_submission": {
            "type": "boolean"
          },
          "private_skill_proposal": {
            "type": "boolean"
          },
          "skill_candidate": {
            "type": "boolean"
          },
          "skill_suggestion": {
            "type": "boolean"
          },
          "resource_submission": {
            "type": "boolean"
          },
          "resource_review": {
            "type": "boolean"
          }
        }
      },
      "privateLearningSubmitApprovals": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        },
        "description": "Legacy per-action approvals. A true value approves the lane of that action."
      }
    }
  }
}
